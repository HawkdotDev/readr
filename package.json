{
  "name": "readr",
  "version": "1.1.0",
  "description": "A fast, 100% local, distraction-free mobile e-reader crafted for serious readers.",
  "main": "expo-router/entry",
  "homepage": "https://github.com/hawkdotdev/readr#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hawkdotdev/readr.git"
  },
  "bugs": {
    "url": "https://github.com/hawkdotdev/readr/issues?q=is%3Aissue+is%3Aopen+label%3Abug"
  },
  "features": {
    "url": "https://github.com/hawkdotdev/readr/issues?q=is%3Aissue+is%3Aopen+label%3Aenhancement"
  },
  "featureRequests": {
    "url": "https://github.com/hawkdotdev/readr/issues?q=is%3Aissue+is%3Aopen+label%3Aenhancement"
  },
  "community": {
    "discussions": "https://github.com/hawkdotdev/readr/discussions",
    "featureRequests": "https://github.com/hawkdotdev/readr/issues?q=is%3Aissue+is%3Aopen+label%3Aenhancement",
    "bugs": "https://github.com/hawkdotdev/readr/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/hawkdotdev"
  },
  "license": "MIT",
  "author": {
    "name": "HawkdotDev",
    "url": "https://github.com/hawkdotdev"
  },
  "contributors": [
    {
      "name": "HawkdotDev",
      "url": "https://github.com/hawkdotdev"
    }
  ],
  "keywords": [
    "ebook-reader",
    "epub",
    "epub3",
    "pdf",
    "cbz",
    "cbr",
    "mobi",
    "azw3",
    "fb2",
    "docx",
    "offline-first",
    "local-first",
    "sqlite",
    "expo",
    "expo-router",
    "react-native",
    "drizzle-orm",
    "bionic-reading",
    "speed-reading",
    "tts",
    "text-to-speech",
    "opds",
    "privacy-first",
    "open-source"
  ],
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.3.14",
  "sideEffects": [
    "*.css"
  ],
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "export": "expo export",
    "export:web": "expo export -p web",
    "doctor": "npx expo-doctor",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "check": "bun run typecheck && bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "clean": "expo start --clear",
    "clean:cache": "bun -e \"require('fs').rmSync('.expo', { recursive: true, force: true }); require('fs').rmSync('node_modules/.cache', { recursive: true, force: true })\"",
    "postinstall": "node scripts/fix-metro-windows.js"
  },
  "dependencies": {
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/space-mono": "^0.4.2",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@fontsource/hubot-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/mona-sans": "^5.3.0",
    "buffer": "^6.0.3",
    "drizzle-orm": "^0.38.4",
    "expo": "~57.0.20",
    "expo-clipboard": "^57.0.1",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "^57.0.4",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-screen-orientation": "~57.0.2",
    "expo-sharing": "~57.0.18",
    "expo-speech": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "jszip": "^3.10.1",
    "lucide-react-native": "^0.475.0",
    "nativewind": "^4.1.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.4",
    "tailwindcss": "^3.4.17",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/bun": "^1.4.0",
    "@types/jszip": "^3.4.1",
    "@types/react": "~19.2.2",
    "drizzle-kit": "^0.30.4",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-worklets"
      ]
    }
  }
}
