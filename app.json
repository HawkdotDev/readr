{
  "$schema": "https://json.schemastore.org/expo.json",
  "expo": {
    "name": "Readr",
    "slug": "readr",
    "version": "1.1.0-beta",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "readr",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hawkdotdev.readr",
      "buildNumber": "2",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSDocumentsFolderUsageDescription": "Readr needs access to import your local e-books."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#18181B"
      },
      "package": "com.hawkdotdev.readr",
      "versionCode": 2,
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
